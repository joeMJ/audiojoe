<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service looks up its notification icons by name at runtime; the release build's
     resource shrinking would remove them, the media session then never starts and Android
     mutes playback in the background. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher*" />
