<?xml version="1.0" encoding="utf-8"?>
<!--
  audiojoe as MSI (WiX 3.14), after the model of tvjoe (packaging/windows/tvjoe.wxs). Built by
  tools/build-windows.ps1; the file list (component group "AppFiles") is generated by the script
  from the Flutter release folder (audiojoe.exe, flutter_windows.dll, plug-in DLLs, libmpv-2.dll,
  data\).

  - Installs per user without administrator rights into %LOCALAPPDATA%\Programs\audiojoe.
  - Start menu shortcut, entry in "Apps & features"; uninstalling removes only the program folder.
    Settings and the offline cache (%APPDATA%\io.github.joemj\audiojoe, %LOCALAPPDATA%\...) stay.
  - The UpgradeCode is fixed and must never change: every new MSI replaces the old one (MajorUpgrade).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="audiojoe" Language="1031" Codepage="1252" Version="$(var.Version)" Manufacturer="John Lose (joeMJ)"
           UpgradeCode="08961280-0487-4193-8731-8DAB34455E03">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64"
             Languages="1031" SummaryCodepage="1252" Description="audiojoe $(var.Version)"
             Comments="Podcasts, Hörbücher, Musik und Radio vom eigenen Server" />

    <!-- Installing the same version again replaces it as well (a rebuilt MSI). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Eine neuere Version von audiojoe ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AudiojoeIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AudiojoeIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joeMJ/audiojoe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/joeMJ/audiojoe" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="audiojoe" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7A4A7814-F2F4-46B8-8681-A50116A62D53">
        <!-- Icon from audiojoe.exe (fixed place), not from the MSI icon cache (changes with every
             update; pinned taskbar entries would show an empty icon). -->
        <Shortcut Id="AppShortcut" Name="audiojoe" Description="Podcasts, Hörbücher, Musik und Radio vom eigenen Server"
                  Target="[INSTALLDIR]audiojoe.exe" WorkingDirectory="INSTALLDIR" />
        <!-- Remove the "Programs" folder only when it is empty afterwards (Windows Installer checks). -->
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\audiojoe\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Close a running audiojoe before the files are replaced (otherwise Windows Installer waits
         for them): ask first; if it still runs, a message offers Retry/Cancel. -->
    <util:CloseApplication Id="CloseAudiojoe" Target="audiojoe.exe" Sequence="1" CloseMessage="yes" PromptToContinue="yes" RebootPrompt="no"
                           Description="audiojoe läuft noch und muss für die Installation beendet werden. Bitte audiojoe schließen und dann „Wiederholen“ wählen." />

    <Feature Id="Main" Title="audiojoe" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
